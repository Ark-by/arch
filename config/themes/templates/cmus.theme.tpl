# cmus — использует ANSI-палитру Kitty (0–15)

# Command line
set color_cmdline_bg=default
set color_cmdline_fg=default

# Messages
set color_error=9
set color_info=14

# Separators
set color_separator=8

# Status line
set color_statusline_bg=4
set color_statusline_fg=0
set color_statusline_attr=bold

# Progress bar
set color_statusline_progress_bg=8
set color_statusline_progress_fg=14

# Currently playing track
set color_titleline_bg=4
set color_titleline_fg=0
set color_titleline_attr=bold

# Main window
set color_win_bg=default
set color_win_fg=default

# Current track
set color_win_cur=14
set color_win_cur_attr=bold

# Selected current track
set color_win_cur_sel_bg=4
set color_win_cur_sel_fg=0
set color_win_cur_sel_attr=bold

# Directories
set color_win_dir=12

# Inactive current selection
set color_win_inactive_cur_sel_bg=8
set color_win_inactive_cur_sel_fg=15

# Inactive selection
set color_win_inactive_sel_bg=8
set color_win_inactive_sel_fg=7

# Active selection
set color_win_sel_bg=4
set color_win_sel_fg=0

# Window titles
set color_win_title_bg=4
set color_win_title_fg=0
set color_win_title_attr=bold

# Album rows
set color_trackwin_album_bg=default
set color_trackwin_album_fg=14
set color_trackwin_album_attr=bold
