# ark — схема micro (Tokyo Night)
# генерируется set-theme из ~/.config/themes/templates/micro.micro.tpl
color-link default "#c0caf5,#1a1b26"
color-link comment "#565f89"
color-link constant "#ff9e64"
color-link identifier "#7aa2f7"
color-link statement "#bb9af7"
color-link preproc "#7dcfff"
color-link type "#2ac3de"
color-link special "#73daca"
color-link underlined "underline #7aa2f7"
color-link error "bold #f7768e"
color-link todo "bold #e0af68"
color-link statusline "#1a1b26,#7aa2f7"
color-link tabbar "#c0caf5,#292e42"
color-link line-number "#414868,#1a1b26"
color-link current-line-number "#ff9e64,#292e42"
color-link gutter-error "#f7768e,#1a1b26"
color-link gutter-warning "#e0af68,#1a1b26"
color-link cursor-line "#292e42"
color-link color-column "#292e42"
color-link matchbrace "#bb9af7"
color-link selection "#c0caf5,#414868"
color-link scrollbar "#202330"
color-link divider "#202330"
