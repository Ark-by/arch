#!/usr/bin/env bash
# colors-audit — ищет цвета, которые НЕ приходят из палитры
set -euo pipefail
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"

echo "== хардкод hex в quickshell (кроме Theme.qml) =="
if grep -rn --include='*.qml' -E '#[0-9a-fA-F]{6}' "$cfg/quickshell" 2>/dev/null | grep -v 'Theme.qml'; then
  echo "  ^ эти строки стоит перевести на Theme.*"
else
  echo "  чисто"
fi

echo
echo "== прочие потребители, которые должны брать ANSI, а не hex =="
for f in "$cfg/zshrc" "$HOME/.zshrc" "$HOME/.oh-my-zsh/custom/themes/ark.zsh-theme" "$cfg/fastfetch/config.jsonc"; do
  [[ -f "$f" ]] || continue
  hits=$(grep -cE '#[0-9a-fA-F]{6}' "$f" || true)
  echo "  $f: hex-литералов = $hits"
done

echo
echo "== палитра vs сгенерированное =="
if [[ -f "$cfg/quickshell/theme.json" && -f "$cfg/kitty/theme.conf" ]]; then
  a=$(jq -r '.ansi[8]' "$cfg/quickshell/theme.json")
  b=$(awk '/^color8 /{print $2}' "$cfg/kitty/theme.conf")
  [[ "$a" == "$b" ]] && echo "  color8 совпадает: $a" || echo "  РАСХОЖДЕНИЕ color8: theme=$a kitty=$b"
fi
for i in 0 1 2 3 7 15; do
  k=$(awk -v n="color$i" '$1==n{print $2}' "$cfg/kitty/theme.conf" 2>/dev/null || true)
  t=$(jq -r ".ansi[$i]" "$cfg/quickshell/theme.json" 2>/dev/null || true)
  [[ -n "$k" && "$k" != "$t" ]] && echo "  РАСХОЖДЕНИЕ color$i: theme=$t kitty=$k"
done
echo "  готово"