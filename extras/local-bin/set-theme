#!/usr/bin/env bash
set -e
file="$HOME/.config/themes/$1.json"
[ -f "$file" ] || { echo "Нет такой темы: $1"; exit 1; }

# 1. Quickshell (панель, меню): он следит за этим файлом и обновляется сам
cp "$file" ~/.config/quickshell/theme.json

# 2. Терминал kitty
{
  jq -r '"background \(.bg)\nforeground \(.fg)\ncursor \(.accent)\nselection_background \(.accent)\nselection_foreground \(.bg)"' "$file"
  jq -r '.ansi | to_entries[] | "color\(.key) \(.value)"' "$file"
} > ~/.config/kitty/theme.conf
pkill -USR1 kitty || true     # сигнал «перечитай конфиг»

# 3. Рамки окон Hyprland
a=$(jq -r '.accent' "$file" | tr -d '#')
m=$(jq -r '.muted'  "$file" | tr -d '#')
cat > ~/.config/hypr/colors.lua <<EOF
return {
  active = "rgba(${a}ff)",
  inactive = "rgba(${m}aa)",
}
EOF
hyprctl reload